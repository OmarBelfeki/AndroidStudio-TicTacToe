<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#fafafa">

    <TextView
        android:id="@+id/partie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Partie 3 / 10"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="50sp"
        android:gravity="center"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

    >
        <LinearLayout
            style="@style/row"
            android:id="@+id/row1"
        >
            <Button
                style="@style/column"
                android:id="@+id/row1_1"
            />
            <View style="@style/verticalLine" />
            <Button
                style="@style/column"
                android:id="@+id/row1_2"

                />
            <View style="@style/verticalLine" />

            <Button
                style="@style/column"
                android:id="@+id/row1_3"

                />
        </LinearLayout>

        <View style="@style/HorizontalLine" />



        <LinearLayout
            style="@style/row"
            android:id="@+id/row2"
            >
            <Button
                style="@style/column"
                android:id="@+id/row2_1"
                />
            <View style="@style/verticalLine" />

            <Button
                style="@style/column"
                android:id="@+id/row2_2"

                />
            <View style="@style/verticalLine" />

            <Button
                style="@style/column"
                android:id="@+id/row2_3"

                />
        </LinearLayout>

        <View style="@style/HorizontalLine" />

        <LinearLayout
            style="@style/row"
            android:id="@+id/row3"
            >
            <Button
                style="@style/column"
                android:id="@+id/row3_1"
                />
            <View style="@style/verticalLine" />

            <Button
                style="@style/column"
                android:id="@+id/row3_2"

                />
            <View style="@style/verticalLine" />

            <Button
                style="@style/column"
                android:id="@+id/row3_3"

                />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center_horizontal"
        android:layout_marginBottom="30dp"

    >
        <TextView
            android:id="@+id/x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X : 2"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#555555"
            android:paddingBottom="8dp"
            android:layout_marginEnd="30dp"
            />

        <TextView
            android:id="@+id/o"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O : 1"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#555555"
            android:paddingBottom="8dp"
            android:layout_marginEnd="30dp"

        />

        <TextView
            android:id="@+id/nulls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nulls : 0"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#555555"
            android:paddingBottom="8dp"
        />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>